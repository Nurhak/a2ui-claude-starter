{
  "name": "a2ui-claude-starter",
  "version": "0.1.0",
  "description": "Claude answers with real UI: a minimal Google A2UI 1.0 + Claude starter (Node agent + React renderer).",
  "scripts": {
    "dev": "concurrently -n agent,web -c yellow,cyan \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "agent": "tsx --env-file-if-exists=.env server/index.ts",
    "web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "test": "tsx server/check.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@a2ui/agent": "^0.2.1",
    "@a2ui/markdown-it": "^0.2.4",
    "@a2ui/react": "^0.16.1",
    "@a2ui/web_core": "^0.16.1",
    "@anthropic-ai/sdk": "^1.13.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  }
}
